<network-security-config>
<!--  Production server uses HTTPS — no cleartext needed  -->
<domain-config cleartextTrafficPermitted="false">
<domain includeSubdomains="true">testott.vsmartengine.com</domain>
</domain-config>
<!--  Local development IPs — allow HTTP  -->
<domain-config cleartextTrafficPermitted="true">
<domain includeSubdomains="true">10.0.2.2</domain>
<domain includeSubdomains="true">192.168.0.8</domain>
<domain includeSubdomains="true">192.168.0.9</domain>
<domain includeSubdomains="true">10.50.175.4</domain>
<domain includeSubdomains="true">localhost</domain>
</domain-config>
</network-security-config>